<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 and older (ignored on 12+, which uses data_extraction_rules.xml). One rule set
   covers both cloud backup and device transfer here, so it follows the cloud constraint:
   settings only — the library would blow the 25 MB quota and fail the whole backup.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
</full-backup-content>
