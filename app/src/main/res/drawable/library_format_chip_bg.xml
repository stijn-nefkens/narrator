<?xml version="1.0" encoding="utf-8"?>
<!--
  Filled chip background — switched from outlined because the stroke kept getting
  clipped at the bottom edge regardless of inset / padding tricks. Filled is more
  legible at this size anyway. The colour is a low-opacity tint of the outline so
  it shows on both light and dark themes.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="3dp" />
    <solid android:color="?attr/colorSurfaceVariant" />
</shape>
