<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Empty state -->
    <TextView
        android:id="@+id/player_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="32dp"
        android:gravity="center"
        android:text="@string/player_empty"
        android:textAppearance="?attr/textAppearanceBody1"
        android:visibility="gone" />

    <!-- Loaded state -->
    <ScrollView
        android:id="@+id/player_loaded"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/player_cover"
                android:layout_width="140dp"
                android:layout_height="190dp"
                android:layout_marginTop="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/nav_player"
                android:src="@drawable/ic_book_placeholder" />

            <TextView
                android:id="@+id/player_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:gravity="center"
                tools:text="A Tale" />

            <TextView
                android:id="@+id/player_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                tools:text="Jane Doe" />

            <TextView
                android:id="@+id/player_chapter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceCaption"
                android:gravity="center"
                tools:text="Chapter 1 of 12 · Down the Rabbit-Hole" />

            <com.example.narrator.ui.player.ChapterTickSeekBar
                android:id="@+id/player_scrub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <!-- progress text removed; the scrub bar already conveys the percentage visually -->
            <TextView
                android:id="@+id/player_progress_text"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Transport controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/player_prev_chapter"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_skip_prev"
                    android:contentDescription="@string/player_prev_chapter" />

                <ImageButton
                    android:id="@+id/player_prev_step"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_step_prev"
                    android:contentDescription="@string/player_prev_step" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/player_play_pause"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginHorizontal="12dp"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="40dp"
                    android:contentDescription="@string/player_play"
                    android:text="" />

                <ImageButton
                    android:id="@+id/player_next_step"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_step_next"
                    android:contentDescription="@string/player_next_step" />

                <ImageButton
                    android:id="@+id/player_next_chapter"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_skip_next"
                    android:contentDescription="@string/player_next_chapter" />
            </LinearLayout>

            <!-- Single action row: [Sleep] [1.00x] [Mark]. All three buttons share a 96dp
                 min-width so the chip line stays visually balanced. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/player_sleep"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="96dp"
                    app:icon="@drawable/ic_sleep"
                    app:iconSize="18dp"
                    android:text="@string/player_sleep_off" />

                <!-- Drag left/right on the value to step speed by 0.1x; tap resets to 1.0x. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/player_speed"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minWidth="96dp"
                    android:contentDescription="@string/player_speed_a11y"
                    tools:text="1.00x" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/player_bookmark"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minWidth="96dp"
                    app:icon="@drawable/ic_bookmark"
                    app:iconSize="18dp"
                    android:text="@string/player_bookmark_label" />
            </LinearLayout>

            <!-- One-line status: either remaining time or "Synthesising…" while a chunk is
                 still being prepared. Keeping it to a single TextView removes the always-
                 reserved blank line the old separate playerSynthesising view occupied. -->
            <TextView
                android:id="@+id/player_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.6"
                android:textAppearance="?attr/textAppearanceCaption"
                tools:text="About 4h 12m remaining" />

            <!-- Follow-along text: stays at the bottom so the controls above don't reflow. -->
            <TextView
                android:id="@+id/player_current_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBody1"
                tools:text="Alice was beginning to get very tired of sitting by her sister." />

            <TextView
                android:id="@+id/player_next_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:alpha="0.5"
                android:textAppearance="?attr/textAppearanceBody2"
                tools:text="So she was considering, in her own mind." />
        </LinearLayout>
    </ScrollView>

    <!-- Loading spinner shown while a book is being parsed (large PDFs take a few seconds). -->
    <ProgressBar
        android:id="@+id/player_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
