<?xml version="1.0" encoding="utf-8"?>
<!-- Row is clickable for the whole-row tap target, but no background highlight: the switch is
     the sole visual cue of which engine is active. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/engine_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceSubtitle1" />

            <TextView
                android:id="@+id/engine_package"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.6"
                android:textAppearance="?attr/textAppearanceCaption" />
        </LinearLayout>

        <!-- Material 3 switch (pill-shaped with growing-thumb animation). Visually shows which
             engine is active; not interactive itself (taps fall through to the row's click
             handler so users can tap anywhere to select). -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/engine_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:textOn=""
            android:textOff="" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/engine_sample"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_setup_sample" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/engine_open_settings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/voice_setup_engine_settings_short" />
    </LinearLayout>
</LinearLayout>
